# ============================================================
# 本地开发用的配置。复制一份叫 .env 再改：cp .env.example .env
#
# 桌面版不读这个文件 —— 它的配置由 desktop/main.js 在启动时传给服务，
# 模型 key 在软件的「设置」页里填。这里只管 `npm run dev` 跑网页调试。
# ============================================================

# 数据库（SQLite）。相对 prisma/ 目录，所以是 ../data
DATABASE_URL="file:../data/secretary.db"

# 上传文件、备份放哪
UPLOAD_DIR="./data/uploads"
BACKUP_DIR="./data/backups"

# ---------- 登录 ----------
#
# 本机开发不需要登录。这两行一起写才生效 —— 关掉登录必须是故意的，
# 不能是忘了配（见 src/lib/env-guard.ts）。
ALLOW_INSECURE_LOCAL="true"
AUTH_ENABLED="false"

# 要把网页版放到服务器上给别人用时：删掉 ALLOW_INSECURE_LOCAL、
# AUTH_ENABLED 改成 "true"，再填下面两个：
#   APP_PASSWORD_HASH  —— node scripts/set-password.mjs <密码>
#   SESSION_SECRET     —— node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_PASSWORD_HASH=""
SESSION_SECRET=""

# ---------- AI 模型 ----------
#
# 任何 OpenAI 兼容接口都行。读账单、体检报告要看图，得用带视觉的模型。
# 也可以留空，启动后在「设置」页里填（存进数据库，优先级高于这里）。
AI_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
AI_API_KEY=""
AI_MODEL="deepseek-v4.1-flash"

# ---------- 货币 ----------
#
# 页面和 CLI 共用，别让两边显示成不同货币。
NEXT_PUBLIC_CURRENCY_SYMBOL="¥"
NEXT_PUBLIC_BASE_CURRENCY="CNY"

# ---------- 备份 ----------
#
# 备份加密口令。不设的话 npm run backup 会报错提示。
BACKUP_PASSPHRASE=""
